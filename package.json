{
  "name": "radiouploader",
  "version": "0.1.0-alpha.1",
  "description": "Desktop uploader for Radiopaedia.org: DICOM ingest, anonymisation and case upload",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "smoke": "electron scripts/smoke.mjs",
    "shots": "npm run build && electron scripts/shots.mjs",
    "sample": "node scripts/sampleStudy.mjs .sample-study",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.5",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.4",
    "@cornerstonejs/codec-openjpeg": "^1.3.2",
    "@cornerstonejs/codec-openjph": "^2.4.9",
    "dicom-parser": "^1.8.21",
    "dicomanon": "github:radiopaedia/dicom-anonymiser",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "mermaid": "^11.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10"
  },
  "author": "Giorgio Maria Agazzi",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmadevs/Radiouploader.git"
  }
}
